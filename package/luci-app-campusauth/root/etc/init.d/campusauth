#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=15

start_service() {
	local enabled
	config_load campusauth
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/campusauth-core daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger campusauth
}

reload_service() {
	stop
	start
}

boot() {
	config_load campusauth
	local auto_resume
	config_get_bool auto_resume main auto_resume_boot 1
	[ "$auto_resume" -eq 1 ] && rm -f /var/run/campusauth.paused
	start
}
